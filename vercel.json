{
  "buildCommand": "pnpm run build",
  "outputDirectory": ".next",
  "installCommand": "pnpm install",
  "framework": "nextjs",
  "functions": {
    "app/api/**/*.ts": {
      "maxDuration": 30
    }
  },
  "env": {
    "PNPM_VERSION": "8.15.0"
  },
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  }
}
